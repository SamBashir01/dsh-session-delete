{
  "name": "dsh-session-delete",
  "version": "0.1.0",
  "description": "Permanently delete a Session from the DeepSeek Harness Web UI",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "exports": { ".": "./index.js", "./client": "./client.js", "./package.json": "./package.json" },
  "files": ["index.js", "client.js", "cordis.patch.yml", "README.md", "LICENSE", "CHANGELOG.md"],
  "repository": { "type": "git", "url": "git+https://github.com/sambashir001/dsh-session-delete.git" },
  "homepage": "https://github.com/sambashir001/dsh-session-delete",
  "publishConfig": { "access": "public" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js"
  }
}
